{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-category-grid-container-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-category-grid-left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-category-grid-right-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-category-grid-2-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 16px;
  }

  .ai-category-grid-1-3-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 240px;
    gap: 16px;
  }

  .ai-category-grid-2-1-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 260px 220px auto;
    gap: 16px;
  }

  .ai-tile-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.tile_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  .ai-tile-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease;
  }

  .ai-tile-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-tile-{{ ai_gen_id }} span {
    position: absolute;
    bottom: 16px;
    left: 16px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    z-index: 2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-tile-science-{{ ai_gen_id }} {
    grid-row: 1 / span 2;
    grid-column: 1 / 2;
  }

  .ai-tile-art-{{ ai_gen_id }} {
    grid-column: 2 / 4;
  }

  .ai-tile-engineering-{{ ai_gen_id }} {
    grid-column: 2 / 4;
  }

  .ai-tile-culture-{{ ai_gen_id }} {
    grid-column: 1 / 2;
  }

  .ai-tile-infant-{{ ai_gen_id }} {
    grid-column: 2 / 5;
  }

  .ai-tile-hero-{{ ai_gen_id }} {
    grid-column: 1 / -1;
  }

  .ai-tile-hero-{{ ai_gen_id }} img {
    height: 265px;
  }

  .ai-tile-wide-{{ ai_gen_id }} {
    grid-column: 1 / -1;
  }

  .ai-tile-half-left-{{ ai_gen_id }} {
    grid-column: 1 / 7;
    height: 240px;
  }

  .ai-tile-half-right-{{ ai_gen_id }} {
    grid-column: 7 / -1;
    height: 240px;
  }

  .ai-tile-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tile-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-category-grid-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-category-grid-2-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ai-tile-science-{{ ai_gen_id }} {
      grid-row: auto;
      grid-column: 1;
    }

    .ai-tile-art-{{ ai_gen_id }},
    .ai-tile-engineering-{{ ai_gen_id }} {
      grid-column: 1;
    }

    .ai-category-grid-1-3-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ai-tile-culture-{{ ai_gen_id }},
    .ai-tile-infant-{{ ai_gen_id }} {
      grid-column: 1;
    }

    .ai-category-grid-2-1-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ai-tile-hero-{{ ai_gen_id }},
    .ai-tile-wide-{{ ai_gen_id }},
    .ai-tile-half-left-{{ ai_gen_id }},
    .ai-tile-half-right-{{ ai_gen_id }} {
      grid-column: 1;
      height: 240px;
    }

    .ai-tile-hero-{{ ai_gen_id }} img {
      height: 240px;
    }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid-container-{{ ai_gen_id }}">
    <div class="ai-category-grid-left-{{ ai_gen_id }}">
      <div class="ai-category-grid-2-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign tile_image_key = 'tile_' | append: i | append: '_image'
            assign tile_title_key = 'tile_' | append: i | append: '_title'
            assign tile_collection_key = 'tile_' | append: i | append: '_collection'
            
            assign tile_image = block.settings[tile_image_key]
            assign tile_title = block.settings[tile_title_key]
            assign tile_collection = block.settings[tile_collection_key]
            
            if tile_collection != blank
              assign tile_url = tile_collection.url
            else
              assign tile_url = '#'
            endif
            
            if i == 1
              assign tile_class = 'ai-tile-science-' | append: ai_gen_id
            elsif i == 2
              assign tile_class = 'ai-tile-art-' | append: ai_gen_id
            else
              assign tile_class = 'ai-tile-engineering-' | append: ai_gen_id
            endif
          %}
          
          <a class="ai-tile-{{ ai_gen_id }} {{ tile_class }}" href="{{ tile_url }}">
            {% if tile_image %}
              <img
                src="{{ tile_image | image_url: width: 800 }}"
                alt="{{ tile_image.alt | escape }}"
                loading="lazy"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
              >
            {% else %}
              <div class="ai-tile-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if tile_title != blank %}
              <span>{{ tile_title }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <div class="ai-category-grid-1-3-{{ ai_gen_id }}">
        {% for i in (4..5) %}
          {% liquid
            assign tile_image_key = 'tile_' | append: i | append: '_image'
            assign tile_title_key = 'tile_' | append: i | append: '_title'
            assign tile_collection_key = 'tile_' | append: i | append: '_collection'
            
            assign tile_image = block.settings[tile_image_key]
            assign tile_title = block.settings[tile_title_key]
            assign tile_collection = block.settings[tile_collection_key]
            
            if tile_collection != blank
              assign tile_url = tile_collection.url
            else
              assign tile_url = '#'
            endif
            
            if i == 4
              assign tile_class = 'ai-tile-culture-' | append: ai_gen_id
            else
              assign tile_class = 'ai-tile-infant-' | append: ai_gen_id
            endif
          %}
          
          <a class="ai-tile-{{ ai_gen_id }} {{ tile_class }}" href="{{ tile_url }}">
            {% if tile_image %}
              <img
                src="{{ tile_image | image_url: width: 800 }}"
                alt="{{ tile_image.alt | escape }}"
                loading="lazy"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
              >
            {% else %}
              <div class="ai-tile-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if tile_title != blank %}
              <span>{{ tile_title }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>

    <div class="ai-category-grid-right-{{ ai_gen_id }}">
      <div class="ai-category-grid-2-1-{{ ai_gen_id }}">
        {% for i in (6..14) %}
          {% liquid
            assign tile_image_key = 'tile_' | append: i | append: '_image'
            assign tile_title_key = 'tile_' | append: i | append: '_title'
            assign tile_collection_key = 'tile_' | append: i | append: '_collection'
            
            assign tile_image = block.settings[tile_image_key]
            assign tile_title = block.settings[tile_title_key]
            assign tile_collection = block.settings[tile_collection_key]
            
            if tile_collection != blank
              assign tile_url = tile_collection.url
            else
              assign tile_url = '#'
            endif
            
            if i == 6
              assign tile_class = 'ai-tile-hero-' | append: ai_gen_id
            elsif i == 7
              assign tile_class = 'ai-tile-wide-' | append: ai_gen_id
            elsif i == 8
              assign tile_class = 'ai-tile-half-left-' | append: ai_gen_id
            elsif i == 9
              assign tile_class = 'ai-tile-half-right-' | append: ai_gen_id
            else
              assign tile_class = ''
            endif
          %}
          
          <a class="ai-tile-{{ ai_gen_id }} {{ tile_class }}" href="{{ tile_url }}">
            {% if tile_image %}
              <img
                src="{{ tile_image | image_url: width: 800 }}"
                alt="{{ tile_image.alt | escape }}"
                loading="lazy"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
              >
            {% else %}
              <div class="ai-tile-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if tile_title != blank %}
              <span>{{ tile_title }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

