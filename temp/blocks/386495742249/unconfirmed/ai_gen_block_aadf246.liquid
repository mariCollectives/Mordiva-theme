      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_hover_background",
      "label": "Navigation hover background",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Latest products slider"
    }
  ]
}
{% endschema %}
