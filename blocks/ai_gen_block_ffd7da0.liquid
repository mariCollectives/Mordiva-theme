          <a class="ai-category-grid__tile-{{ ai_gen_id }}" href="{{ block.settings.tile_1_link }}">
            <img src="{{ block.settings.tile_1_image | image_url: width: 600 }}" alt="{{ block.settings.tile_1_text | escape }}" loading="lazy">
