                 alt="{{ block.settings.tile_11_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_11_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}
      </div>
    </div>

    <div style="flex:1 1 0; min-width:320px;">
      <div style="display:grid; grid-template-columns:2.3fr 1fr; gap:{{ gap }}px;">
        {% if block.settings.tile_12_image %}
          <a href="{{ block.settings.tile_12_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_12_image | image_url: width: 1600 }}"
                 alt="{{ block.settings.tile_12_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_12_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {% if block.settings.tile_13_image %}
          <a href="{{ block.settings.tile_13_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_13_image | image_url: width: 900 }}"
                 alt="{{ block.settings.tile_13_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_13_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}
      </div>
    </div>

  </div>

  {# ---------------- ROW 3 (3 columns) ---------------- #}
  <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:{{ gap }}px; margin-top:{{ gap }}px;">

    {% if block.settings.tile_14_image %}
      <a href="{{ block.settings.tile_14_link | default: '#' }}"
         style="{{ tile_base }} height:220px;">
        <img src="{{ block.settings.tile_14_image | image_url: width: 1200 }}"
             alt="{{ block.settings.tile_14_text | escape }}"
             loading="lazy"
             style="{{ img_base }}">
        <span style="{{ label_base }}">{{ block.settings.tile_14_text }}</span>
        <span aria-hidden="true" style="{{ overlay_base }}"></span>
      </a>
    {% endif %}

    {% if block.settings.tile_15_image %}
      <a href="{{ block.settings.tile_15_link | default: '#' }}"
         style="{{ tile_base }} height:220px;">
        <img src="{{ block.settings.tile_15_image | image_url: width: 1200 }}"
             alt="{{ block.settings.tile_15_text | escape }}"
             loading="lazy"
             style="{{ img_base }}">
        <span style="{{ label_base }}">{{ block.settings.tile_15_text }}</span>
        <span aria-hidden="true" style="{{ overlay_base }}"></span>
      </a>
    {% endif %}

    {% if block.settings.tile_16_image %}
      <a href="{{ block.settings.tile_16_link | default: '#' }}"
         style="{{ tile_base }} height:220px;">
        <img src="{{ block.settings.tile_16_image | image_url: width: 1200 }}"
             alt="{{ block.settings.tile_16_text | escape }}"
             loading="lazy"
             style="{{ img_base }}">
        <span style="{{ label_base }}">{{ block.settings.tile_16_text }}</span>
        <span aria-hidden="true" style="{{ overlay_base }}"></span>
      </a>
    {% endif %}

  </div>

</div>

