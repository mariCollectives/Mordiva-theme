{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign gap = 16
  assign radius = 18
  assign tile_base = "position:relative; display:block; overflow:hidden; border-radius:" | append: radius | append: "px; text-decoration:none;"
  assign img_base  = "width:100%; height:100%; display:block; object-fit:cover;"
  assign label_base = "position:absolute; left:16px; bottom:16px; color:#fff; font-size:18px; font-weight:600; line-height:1.2; z-index:3;"
  assign overlay_base = "position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,0) 65%); z-index:2;"
-%}

<div {{ block.shopify_attributes }}
  style="max-width:1400px; margin:0 auto; padding:0 16px;">

  {# ---------------- ROW 1 (50/50) ---------------- #}
  <div style="display:flex; gap:{{ gap }}px; align-items:stretch; flex-wrap:wrap;">

    {# LEFT 50% #}
    <div style="flex:1 1 0; min-width:320px;">

      {# top 3 tiles in a row #}
      <div style="display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:{{ gap }}px;">

        {% if block.settings.tile_1_image %}
          <a href="{{ block.settings.tile_1_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_1_image | image_url: width: 900 }}"
                 alt="{{ block.settings.tile_1_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_1_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {% if block.settings.tile_2_image %}
          <a href="{{ block.settings.tile_2_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_2_image | image_url: width: 900 }}"
                 alt="{{ block.settings.tile_2_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_2_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {% if block.settings.tile_3_image %}
          <a href="{{ block.settings.tile_3_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_3_image | image_url: width: 900 }}"
                 alt="{{ block.settings.tile_3_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_3_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

      </div>

      {# bottom 2 tiles (25% / 75% look) #}
      <div style="display:grid; grid-template-columns:1fr 3fr; gap:{{ gap }}px; margin-top:{{ gap }}px;">

        {% if block.settings.tile_4_image %}
          <a href="{{ block.settings.tile_4_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_4_image | image_url: width: 900 }}"
                 alt="{{ block.settings.tile_4_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_4_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {% if block.settings.tile_5_image %}
          <a href="{{ block.settings.tile_5_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
            <img src="{{ block.settings.tile_5_image | image_url: width: 1200 }}"
                 alt="{{ block.settings.tile_5_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_5_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

      </div>

    </div>

    {# RIGHT 50% (2-1 layout) #}
    <div style="flex:1 1 0; min-width:320px;">
      <div style="display:grid; grid-template-columns:1.2fr 1fr; grid-template-rows:220px 220px; gap:{{ gap }}px;">

        {# hero spans 2 rows #}
        {% if block.settings.tile_6_image %}
          <a href="{{ block.settings.tile_6_link | default: '#' }}"
             style="{{ tile_base }} grid-row:1 / span 2; height:100%;">
            <img src="{{ block.settings.tile_6_image | image_url: width: 1600 }}"
                 alt="{{ block.settings.tile_6_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_6_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {# wide top-right #}
        {% if block.settings.tile_7_image %}
          <a href="{{ block.settings.tile_7_link | default: '#' }}"
             style="{{ tile_base }} height:100%;">
            <img src="{{ block.settings.tile_7_image | image_url: width: 1200 }}"
                 alt="{{ block.settings.tile_7_text | escape }}"
                 loading="lazy"
                 style="{{ img_base }}">
            <span style="{{ label_base }}">{{ block.settings.tile_7_text }}</span>
            <span aria-hidden="true" style="{{ overlay_base }}"></span>
          </a>
        {% endif %}

        {# bottom-right split into 2 halves inside a nested grid #}
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:{{ gap }}px;">
          {% if block.settings.tile_8_image %}
            <a href="{{ block.settings.tile_8_link | default: '#' }}"
               style="{{ tile_base }} height:220px;">
              <img src="{{ block.settings.tile_8_image | image_url: width: 900 }}"
                   alt="{{ block.settings.tile_8_text | escape }}"
                   loading="lazy"
                   style="{{ img_base }}">
              <span style="{{ label_base }}">{{ block.settings.tile_8_text }}</span>
              <span aria-hidden="true" style="{{ overlay_base }}"></span>
            </a>
          {% endif %}

          {% if block.settings.tile_9_image %}
            <a href="{{ block.settings.tile_9_link | default: '#' }}"
               style="{{ tile_base }} height:220px;">
              <img src="{{ block.settings.tile_9_image | image_url: width: 900 }}"
                   alt="{{ block.settings.tile_9_text | escape }}"
                   loading="lazy"
                   style="{{ img_base }}">
              <span style="{{ label_base }}">{{ block.settings.tile_9_text }}</span>
              <span aria-hidden="true" style="{{ overlay_base }}"></span>
            </a>
          {% endif %}
        </div>

      </div>
    </div>

  </div>

  {# ---------------- ROW 2 (35/65) ---------------- #}
  <div style="display:flex; gap:{{ gap }}px; margin-top:{{ gap }}px; flex-wrap:wrap;">

    <div style="flex:0 0 35%; min-width:320px;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:{{ gap }}px;">
        {% if block.settings.tile_10_image %}
          <a href="{{ block.settings.tile_10_link | default: '#' }}"
             style="{{ tile_base }} height:220px;">
