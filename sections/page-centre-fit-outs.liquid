{% comment %}
  Centre Fit Outs Page Section
  Fully customizable in Theme Editor
{% endcomment %}

<section class="centre-fit-outs">

  <!-- HERO -->
  <div class="cfo-hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image 
        | image_url: width: 2000 
        | image_tag: 
          class: 'cfo-hero__img',
          loading: 'lazy'
      }}
    {% endif %}

    <div class="cfo-hero__overlay">
      <h1 class="cfo-hero__title">
        {{ section.settings.hero_title }}
      </h1>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="cfo-content page-width">
    <h2 class="cfo-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="cfo-grid">
      
      <div class="cfo-text">
        {{ section.settings.text }}
      </div>

      <div class="cfo-image">
        {% if section.settings.side_image != blank %}
          {{ section.settings.side_image 
            | image_url: width: 1200 
            | image_tag:
              class: 'cfo-side__img',
              loading: 'lazy'
          }}
        {% endif %}
      </div>

    </div>
  </div>

</section>

<style>
.centre-fit-outs {
  background: #f5f5f5;
}

/* HERO */
.cfo-hero {
  position: relative;
  height: 420px;
  overflow: hidden;
}

.cfo-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cfo-hero__overlay {
  position: absolute;
  bottom: 40px;
  left: 60px;
  color: #fff;
}

.cfo-hero__title {
  font-size: 40px;
  font-weight: 600;
  margin: 0;
}

/* CONTENT */
.cfo-content {
  padding: 60px 0;
}

.cfo-heading {
  font-size: 28px;
  margin-bottom: 30px;
}

.cfo-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 40px;
  align-items: center;
}

.cfo-text {
  font-size: 16px;
  line-height: 1.7;
}

.cfo-side__img {
  width: 100%;
  border-radius: 16px;
}

/* MOBILE */
@media screen and (max-width: 768px) {

  .cfo-hero {
    height: 300px;
  }

  .cfo-hero__overlay {
    left: 20px;
    bottom: 20px;
  }

  .cfo-hero__title {
    font-size: 28px;
  }

  .cfo-grid {
    grid-template-columns: 1fr;
  }

}
</style>

{% schema %}
{
  "name": "Centre Fit Outs Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Centre Fit Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Where Inspiring Learning Environments Begin"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Right Side Image"
    }
  ],
  "presets": [
    {
      "name": "Centre Fit Outs Page"
    }
  ]
}
{% endschema %}
