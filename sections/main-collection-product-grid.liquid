{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_filter_size = 0
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = 3
  assign columns_tablet_large = 4
  assign columns_mobile = section.settings.columns_mobile | times: 1

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor

  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type
  assign show_toolbar = false
  if enable_filtering or enable_sorting
    assign show_toolbar = true
  endif

  assign default_grid_mobile = 'f-grid-' | append: columns_mobile | append: '-cols'

  assign is_metro = false
  if section.settings.grid_layout == 'metro'
    assign is_metro = true
  endif
-%}
{%- if is_metro -%}
  {%- render 'product-grid-metro-style',
    section_id: section.id,
    columns_desktop: columns_desktop,
    columns_tablet_large: columns_tablet_large,
    columns_tablet: columns_tablet,
    columns_mobile: columns_mobile
  -%}
{%- endif -%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1279px) calc((100vw - 90px) / {{ columns_tablet }}),
{%- if enable_filtering -%}
  calc({{ settings.page_width}}px / {{ columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endif -%}
{%- endcapture -%}


  {%- paginate collection.products by section.settings.products_per_page -%}
     <div class="sticky-element grid gap-5 z-10" style="--sticky-offset: 0px;">
          {%- if enable_filtering or enable_sorting -%}
                <div class="col-toolbar" data-col-toolbar>
                  <div class="page-width">
                  <form class="col-toolbar__form" method="get" action="{{ collection.url }}" id="CollectionFiltersForm">

                   {%- assign total_results = collection.products_count -%}
                    {%- assign total_all = collection.all_products_count -%}

                    {%- assign start_index = paginate.current_offset | plus: 1 -%}
                    {%- assign end_index = paginate.current_offset | plus: paginate.page_size -%}
                    {%- if end_index > paginate.items -%}{%- assign end_index = paginate.items -%}{%- endif -%}

                    <div class="col-results" aria-live="polite">
                      {%- if paginate.items > 0 -%}
                        Showing {{ start_index }}–{{ end_index }} of {{ paginate.items }}
                        {%- if total_results != total_all -%}
                          (filtered from {{ total_all }})
                        {%- endif -%}
                      {%- else -%}
                        No results found.
                      {%- endif -%}
                    </div>


                    <!-- preserve sort -->
                    <div class="col-toolbar__left">
                      <label class="col-toolbar__label" for="SortBy">Sort By:</label>
                      <div class="col-select">
                        <select id="SortBy" name="sort_by" class="col-select__field" aria-label="Sort by">
                          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                          {%- for option in collection.sort_options -%}
                            <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                              {{ option.name }}
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="col-select__chev" aria-hidden="true">▾</span>
                      </div>
                    </div>

                    <!-- filter dropdowns -->
                    {%- if enable_filtering and collection.all_products_count > 0 -%}
                      <div class="col-toolbar__mid desktopview-filter">
                        {%- for filter in collection.filters -%}
                          {%- if filter.type == 'price_range' -%}{%- continue -%}{%- endif -%}

                          <details class="col-dd" data-filter>
                            <summary class="col-dd__summary">
                              {{ filter.label }}
                              <span class="col-dd__chev" aria-hidden="true">▾</span>
                            </summary>

                            <div class="col-dd__panel">
                              {%- if filter.type == 'list' -%}
                                <ul class="col-dd__list" role="list">
                                  {%- for v in filter.values -%}
                                    <li class="col-dd__item">
                                      <label class="col-dd__opt {% if v.count == 0 and v.active == false %}is-disabled{% endif %}">
                                        <input
                                          type="checkbox"
                                          name="{{ v.param_name }}"
                                          value="{{ v.value }}"
                                          {% if v.active %}checked{% endif %}
                                          {% if v.count == 0 and v.active == false %}disabled{% endif %}
                                        >
                                        <span class="col-dd__text">{{ v.label }}</span>
                                        <span class="col-dd__count">{{ v.count }}</span>
                                      </label>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                          </details>
                        {%- endfor -%}

                        <a class="col-clear" href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}">
                          Clear Filter
                        </a>
                      </div>
                    {%- endif -%}

                    <!-- price slider -->
                    {%- assign price_filter = collection.filters | where: 'type', 'price_range' | first -%}
                    {%- if enable_filtering and price_filter != blank -%}
                      {%- assign max_value = price_filter.range_max | default: 0 -%}
                      {%- assign min_active = price_filter.min_value.value | default: 0 -%}
                      {%- assign max_active = price_filter.max_value.value | default: max_value -%}

                      <div class="col-toolbar__right" data-price-range
                          data-max="{{ max_value }}"
                          data-min-active="{{ min_active }}"
                          data-max-active="{{ max_active }}">
                        <div class="col-price">
                          <span class="col-price__val" data-price-min>{{ min_active | money }}</span>

                          <div class="col-price__track">
                            <input class="col-price__range" type="range" min="0" max="{{ max_value }}" step="100"
                                  value="{{ min_active }}" data-min-range aria-label="Minimum price">
                            <input class="col-price__range" type="range" min="0" max="{{ max_value }}" step="100"
                                  value="{{ max_active }}" data-max-range aria-label="Maximum price">
                          </div>

                          <span class="col-price__val" data-price-max>{{ max_active | money }}</span>

                          <input type="hidden" name="{{ price_filter.min_value.param_name }}" value="{{ min_active }}" data-min-input>
                          <input type="hidden" name="{{ price_filter.max_value.param_name }}" value="{{ max_active }}" data-max-input>
                        </div>
                      </div>
                    {%- endif -%}




                    <div class="filter-available">
                          <!-- filter dropdowns -->
                    {%- if enable_filtering and collection.all_products_count > 0 -%}
                      <div class="col-toolbar__mid mobile-viewFilter">
                        {%- for filter in collection.filters -%}
                          {%- if filter.type == 'price_range' -%}{%- continue -%}{%- endif -%}

                          <details class="col-dd" data-filter>
                            <summary class="col-dd__summary">
                              {{ filter.label }}
                              <span class="col-dd__chev" aria-hidden="true">▾</span>
                            </summary>

                            <div class="col-dd__panel">
                              {%- if filter.type == 'list' -%}
                                <ul class="col-dd__list" role="list">
                                  {%- for v in filter.values -%}
                                    <li class="col-dd__item">
                                      <label class="col-dd__opt {% if v.count == 0 and v.active == false %}is-disabled{% endif %}">
                                        <input
                                          type="checkbox"
                                          name="{{ v.param_name }}"
                                          value="{{ v.value }}"
                                          {% if v.active %}checked{% endif %}
                                          {% if v.count == 0 and v.active == false %}disabled{% endif %}
                                        >
                                        <span class="col-dd__text">{{ v.label }}</span>
                                        <span class="col-dd__count">{{ v.count }}</span>
                                      </label>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                          </details>
                        {%- endfor -%}

                        <a class="col-clear" href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}">
                          Clear Filter
                        </a>
                      </div>

                       </div>
                    {%- endif -%}
                   


                    <button class="col-toolbar__submit" type="submit">Apply</button>


                   


                  </form>




                </div>
              {%- endif -%}

          </div>

  </div>
  

<div
  class="section--padding color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>


  <div class="collection page-width">
      <div class="collection__content flex">
        <div class="flex flex-col flex-grow{% if show_toolbar %} show-toolbar{% endif %}" id="ProductGridWrapper">
         
          <div id="ProductGridContainer">
            {%- if collection.products.size == 0 -%}
              <div class="empty-state flex flex-col items-center justify-center gap-6 text-center">
                {%- if collection.all_products_count > 0 -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.no_results' | t }}</p>
                    <p class="m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ collection.url }}" is="facet-remove">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
            <grid-list
              id="ProductsList"
              class="grid-list products-list f-grid md:f-grid-{{ columns_tablet }}-cols lg:f-grid-{{ columns_tablet_large }}-cols xl:f-grid-{{ columns_desktop }}-cols {{ default_grid_mobile }} f-grid--gap-medium"
            >
              {%- for product in collection.products -%}
                <div class="f-column card">
                  {%- if is_metro -%}
                    {%- render 'card-product-metro',
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index,
                      index0: forloop.index0,
                      desktop_breakpoint: 1280,
                      columns_desktop: columns_desktop,
                      columns_tablet: columns_tablet,
                      columns_mobile: columns_mobile
                    -%}
                  {%- else -%}
                    {%- render 'card-product',
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index
                    -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </grid-list>
            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, type: section.settings.pagination
              endif
            -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

<script>
(function(){
  const root = document.querySelector('[data-col-toolbar]');
  if(!root) return;

  const form = root.querySelector('#CollectionFiltersForm');
  if(!form) return;

  // Close other dropdowns when one opens
  const dds = Array.from(root.querySelectorAll('.col-dd'));
  dds.forEach(dd => {
    dd.addEventListener('toggle', () => {
      if(dd.open) dds.forEach(o => { if(o !== dd) o.open = false; });
    });
  });
  document.addEventListener('click', (e) => {
    if(!root.contains(e.target)) dds.forEach(dd => dd.open = false);
  });

  const submitForm = () => {
    if (form.requestSubmit) form.requestSubmit();
    else form.submit();
  };

  // Auto-submit on sort change
  const sort = root.querySelector('#SortBy');
  if(sort) sort.addEventListener('change', submitForm);

  // Auto-submit on filter change (checkboxes)
  root.querySelectorAll('details.col-dd input[type="checkbox"]').forEach(inp => {
    inp.addEventListener('change', submitForm);
  });

  // Price range handling
  const priceWrap = root.querySelector('[data-price-range]');
  if(priceWrap){
    const max = Number(priceWrap.dataset.max || 0);
    const minR = priceWrap.querySelector('[data-min-range]');
    const maxR = priceWrap.querySelector('[data-max-range]');
    const minI = priceWrap.querySelector('[data-min-input]');
    const maxI = priceWrap.querySelector('[data-max-input]');
    const minT = priceWrap.querySelector('[data-price-min]');
    const maxT = priceWrap.querySelector('[data-price-max]');

    const money = (cents) => {
      const v = Math.max(0, Math.round(cents));
      return (v/100).toLocaleString(undefined,{
        style:'currency',
        currency:(window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD'
      });
    };

    const clamp = () => {
      let a = Number(minR.value);
      let b = Number(maxR.value);
      if(a > b){ const t=a; a=b; b=t; }
      minR.value = a; maxR.value = b;
      minI.value = a; maxI.value = b;
      if(minT) minT.textContent = money(a);
      if(maxT) maxT.textContent = money(b);
    };

    clamp();

    let t;
    const submitSoon = () => {
      clearTimeout(t);
      t = setTimeout(submitForm, 350);
    };

    minR.addEventListener('input', clamp);
    maxR.addEventListener('input', clamp);
    minR.addEventListener('change', () => { clamp(); submitSoon(); });
    maxR.addEventListener('change', () => { clamp(); submitSoon(); });

    if(max > 0){
      minR.max = max; maxR.max = max;
    }
  }
})();
</script>




{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://foxecom.link/LgqT3v8)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 15,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.product-tabs.settings.grid_layout.options__1.label"
        },
        {
          "value": "metro",
          "label": "t:sections.product-tabs.settings.grid_layout.options__2.label"
        }
      ],
      "default": "standard",
      "info": "t:sections.product-tabs.settings.grid_layout.info",
      "label": "t:sections.product-tabs.settings.grid_layout.label"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main-collection-product-grid.settings.pagination.label",
      "options": [
        {
          "value": "infinite",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__1.label"
        },
        {
          "value": "load_more",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__2.label"
        },
        {
          "value": "number",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__3.label"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatch",
      "label": "t:settings_schema.color_swatches.settings.enable_color_swatch.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "vertical",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label",
      "info": "t:sections.main-collection-product-grid.settings.filter_type.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "t:sections.main-collection-product-grid.settings.expand_filter_groups.label",
      "placeholder": "Color, Price, Size",
      "info": "t:sections.main-collection-product-grid.settings.expand_filter_groups.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    }
  ]
}
{% endschema %}
