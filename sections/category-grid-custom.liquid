{% comment %}
  Section: Category Grid (Blocks)
  - Same CSS/layout as provided
  - Each tile is a block (image + collection + title)
  - Block has a "slot" dropdown to place it into the fixed layout positions
{% endcomment %}

<section id="cat-grid-{{ section.id }}">

  <style>
  #cat-grid-{{ section.id }} {

  }

  #cat-grid-{{ section.id }} .category-grid-2-1 {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 260px 220px auto;
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
  }

  #cat-grid-{{ section.id }} .category-grid-1-3 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 240px 0;
    gap: 16px;
    max-width: 100%;
  }

  #cat-grid-{{ section.id }} .category-grid-2 {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 16px;
    max-width: 100%;
  }

  #cat-grid-{{ section.id }} .grid-inner-70-30 {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 18px;
    align-items: end;
  }

  #cat-grid-{{ section.id }} .tile {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
  }

  #cat-grid-{{ section.id }} .tile img {
    width: 100%;
    height: 248px;
    object-fit: cover;
    display: block;
  }

  #cat-grid-{{ section.id }} .tile span {
    position: absolute;
    bottom: 16px;
    left: 16px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    z-index: 2;
  }

  #cat-grid-{{ section.id }} .tile--science {
    grid-row: 1 / span 2;
    grid-column: 1 / 2;
  }

  #cat-grid-{{ section.id }} .tile--art { grid-column: 2 / 4; }
  #cat-grid-{{ section.id }} .tile--engineering { grid-column: 2 / 4; }

  #cat-grid-{{ section.id }} .tile--culture { grid-column: 1 / 2; }
  #cat-grid-{{ section.id }} .tile--infant { grid-column: 2 / 5; }

  #cat-grid-{{ section.id }} .padding-15 { padding-top: 15px; }

  #cat-grid-{{ section.id }} .width-50{
    width:48%;
    display: inline-block;
    float:left;
  }

  #cat-grid-{{ section.id }} .margin-left-2{ margin-right: 20px; }

  #cat-grid-{{ section.id }} .tile--hero { grid-column: 1 / -1; }
  #cat-grid-{{ section.id }} .tile--wide { grid-column: 1 / -1; }

  #cat-grid-{{ section.id }} .tile--half-left {
    grid-column: 1 / 7;
    height: 240px;
  }

  #cat-grid-{{ section.id }} .tile--half-right {
    grid-column: 7 / -1;
    height: 200px;
  }

  #cat-grid-{{ section.id }} .height-auto{ height: auto; }
  #cat-grid-{{ section.id }} .height-set{ height: 245px; }
  #cat-grid-{{ section.id }} .float-left{ float: left; }
  #cat-grid-{{ section.id }} .clear{ clear: both; }

  #cat-grid-{{ section.id }} .width-35{
    width:35%;
    display: inline-block;
    float:left;
  }

  #cat-grid-{{ section.id }} .width-65{
    width: 65%;
    display: inline-block;
  }

  #cat-grid-{{ section.id }} .tile:hover img {
    transform: scale(1.05);
    transition: transform 260ms ease;
  }
  #cat-grid-{{ section.id }} .tile img {
    transition: transform 260ms ease;
  }

  #cat-grid-{{ section.id }} .tile--tall {
    transform: translateY(-18px);
    position: relative;
    z-index: 1;
    overflow: hidden;
    left: 73%;
    top: -9%;
    left: -1.6%;
    width: 90%;
    border-radius: 20px;
  }

  #cat-grid-{{ section.id }} .tile--tall img{ height: 300px; }
  #cat-grid-{{ section.id }} .cat-tile--wide{ margin-bottom: 55px; }
  #cat-grid-{{ section.id }} .tile--science img{ height: 100%; }
  #cat-grid-{{ section.id }} .tile--hero img{ height: 265px; }

  #cat-grid-{{ section.id }} .category-grid-3-col {
    display: grid;
    grid-template-columns: 25% 35% 40%;
    gap: 16px;
    max-width: 95%;
    margin-top: -2em;
    margin-bottom: 30px;
  }

  #cat-grid-{{ section.id }} .tile-image-height-fix img{ height: 280px; }
  </style>

  {% comment %}
    Build slot map from blocks.
    Each slot expects ONE block. If you add duplicates, the last one wins.
  {% endcomment %}

{% liquid
  assign b_science = nil
  assign b_art = nil
  assign b_engineering = nil
  assign b_culture = nil
  assign b_infant = nil

  assign b_hero = nil
  assign b_wide = nil
  assign b_half_left = nil
  assign b_half_right = nil

  assign b_lower_half_left = nil
  assign b_lower_half_right = nil

  assign b_music = nil
  assign b_math = nil

  assign b_bottom_1 = nil
  assign b_bottom_2 = nil
  assign b_bottom_3 = nil
%}

{% for block in section.blocks %}
  {% if block.type == 'tile' %}
    {% case block.settings.slot %}
      {% when 'science' %}{% assign b_science = block %}
      {% when 'art' %}{% assign b_art = block %}
      {% when 'engineering' %}{% assign b_engineering = block %}
      {% when 'culture' %}{% assign b_culture = block %}
      {% when 'infant' %}{% assign b_infant = block %}

      {% when 'hero' %}{% assign b_hero = block %}
      {% when 'wide' %}{% assign b_wide = block %}
      {% when 'half_left' %}{% assign b_half_left = block %}
      {% when 'half_right' %}{% assign b_half_right = block %}

      {% when 'lower_half_left' %}{% assign b_lower_half_left = block %}
      {% when 'lower_half_right' %}{% assign b_lower_half_right = block %}

      {% when 'music' %}{% assign b_music = block %}
      {% when 'math' %}{% assign b_math = block %}

      {% when 'bottom_1' %}{% assign b_bottom_1 = block %}
      {% when 'bottom_2' %}{% assign b_bottom_2 = block %}
      {% when 'bottom_3' %}{% assign b_bottom_3 = block %}
    {% endcase %}
  {% endif %}
{% endfor %}


  {% comment %}
    Tile renderer snippet (inline): uses block image/collection/title (HTML allowed)
  {% endcomment %}
  {% capture placeholder_tile %}
    <a class="tile" href="#">
      {{ 'image' | placeholder_svg_tag }}
      <span>Tile</span>
    </a>
  {% endcapture %}

  {% comment %} LEFT HALF {% endcomment %}
  <div class="width-50 margin-left-2">
    <div class="category-grid-2">

      {% if b_science %}
        {% assign b = b_science %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--science" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_art %}
        {% assign b = b_art %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--art" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_engineering %}
        {% assign b = b_engineering %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--engineering" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

    </div>

    <div class="category-grid-1-3 padding-15">

      {% if b_culture %}
        {% assign b = b_culture %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--culture" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_infant %}
        {% assign b = b_infant %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--infant" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

    </div>
  </div>

  {% comment %} RIGHT HALF {% endcomment %}
  <div class="width-50">
    <div class="category-grid-2-1">

      {% if b_hero %}
        {% assign b = b_hero %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--hero" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_wide %}
        {% assign b = b_wide %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--wide" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_half_left %}
        {% assign b = b_half_left %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--half-left" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_half_right %}
        {% assign b = b_half_right %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a class="tile tile--half-right" href="{{ link }}" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

    </div>
  </div>

  <div class="clear"></div>

  {% comment %} LOWER AREA {% endcomment %}
  <div class="width-full">

    <div class="width-35">
      <div class="width-full margin-left-2">
        <div class="category-grid-2-1 height-set">

          {% if b_lower_half_left %}
            {% assign b = b_lower_half_left %}
            {% assign link = b.settings.collection.url | default: '#' %}
            <a class="tile tile--half-left height-set" href="{{ link }}" {{ b.shopify_attributes }}>
              {% if b.settings.image != blank %}
                {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
              <span>{{ b.settings.title }}</span>
            </a>
          {% endif %}

          {% if b_lower_half_right %}
            {% assign b = b_lower_half_right %}
            {% assign link = b.settings.collection.url | default: '#' %}
            <a class="tile tile--half-right height-set" href="{{ link }}" {{ b.shopify_attributes }}>
              {% if b.settings.image != blank %}
                {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
              <span>{{ b.settings.title }}</span>
            </a>
          {% endif %}

        </div>
      </div>
    </div>

    <div class="width-65">
      <div class="grid-inner-70-30">

        {% if b_music %}
          {% assign b = b_music %}
          {% assign link = b.settings.collection.url | default: '#' %}
          <a class="tile cat-tile--wide" href="{{ link }}" {{ b.shopify_attributes }}>
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          </a>
        {% endif %}

        {% if b_math %}
          {% assign b = b_math %}
          {% assign link = b.settings.collection.url | default: '#' %}
          <a class="tile tile--tall" href="{{ link }}" {{ b.shopify_attributes }}>
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          </a>
        {% endif %}

      </div>
    </div>

  </div>

  <div class="width-full">
    <div class="category-grid-3-col">

      {% if b_bottom_1 %}
        {% assign b = b_bottom_1 %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a href="{{ link }}" class="tile tile-image-height-fix" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_bottom_2 %}
        {% assign b = b_bottom_2 %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a href="{{ link }}" class="tile tile-image-height-fix" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

      {% if b_bottom_3 %}
        {% assign b = b_bottom_3 %}
        {% assign link = b.settings.collection.url | default: '#' %}
        <a href="{{ link }}" class="tile tile-image-height-fix" {{ b.shopify_attributes }}>
          {% if b.settings.image != blank %}
            {{ b.settings.image | image_url: width: 2400 | image_tag: alt: b.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ b.settings.title }}</span>
        </a>
      {% endif %}

    </div>
  </div>

  <style>
  @media (max-width: 780px) {

    #cat-grid-{{ section.id }} .category-grid-2-1 {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    #cat-grid-{{ section.id }} .grid-inner-70-30 {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #cat-grid-{{ section.id }} .category-grid-1-3 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 240px 0;
      gap: 16px;
      max-width: 1400px;
      margin: 0 auto;
    }

    #cat-grid-{{ section.id }} .category-grid-2 {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    #cat-grid-{{ section.id }} .category-grid-3-35-65 {
      grid-template-columns: 1fr;
    }

    #cat-grid-{{ section.id }} .tile {
      height: 220px;
    }

    #cat-grid-{{ section.id }} .tile--science,
    #cat-grid-{{ section.id }} .tile--art,
    #cat-grid-{{ section.id }} .tile--engineering,
    #cat-grid-{{ section.id }} .tile--culture,
    #cat-grid-{{ section.id }} .tile--infant {
      grid-column: auto;
      grid-row: auto;
    }
  }
  </style>

</section>

{% schema %}
{
  "name": "Category Grid",
  "max_blocks": 16,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "slot",
          "label": "Slot / Position",
          "options": [
            { "value": "science", "label": " Science (left big)" },
            { "value": "art", "label": "Art (left top right)" },
            { "value": "engineering", "label": "Engineering (left bottom right)" },
            { "value": "culture", "label": "Culture (left small)" },
            { "value": "infant", "label": "Infant (left wide)" },

            { "value": "hero", "label": " Hero (right top)" },
            { "value": "wide", "label": "Wide (right middle)" },
            { "value": "half_left", "label": "Half Left (right bottom left)" },
            { "value": "half_right", "label": "Half Right (right bottom right)" },

            { "value": "lower_half_left", "label": "Lower Half Left (bottom left)" },
            { "value": "lower_half_right", "label": "Lower Half Right (bottom right)" },

            { "value": "music", "label": "Music Wide (bottom 65% left)" },
            { "value": "math", "label": "Math Tall (bottom 65% right)" },

            { "value": "bottom_1", "label": "Bottom 3-col #1" },
            { "value": "bottom_2", "label": "Bottom 3-col #2" },
            { "value": "bottom_3", "label": "Bottom 3-col #3" }
          ],
          "default": "science"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Link (Collection)" },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title (HTML allowed like <br>)",
          "default": "Title"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Category Grid" }
  ]
}
{% endschema %}
