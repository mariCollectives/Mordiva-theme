<section id="cat-grid-{{ section.id }}" class="grid-mosaic-full">

  <style>
  #cat-grid-{{ section.id }} {}

  /* ✅ TOP WRAPPER (LEFT + RIGHT) — fixes width/layout */
  #cat-grid-{{ section.id }} .cat-grid-top {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }

  /* ✅ STOP FLOAT DAMAGE */
  #cat-grid-{{ section.id }} .width-50,
  #cat-grid-{{ section.id }} .width-35,
  #cat-grid-{{ section.id }} .width-65 {
    width: auto;
    float: none;
    display: block;
  }

  #cat-grid-{{ section.id }} .margin-left-2 { margin-right: 0; }
  #cat-grid-{{ section.id }} .clear { clear: both; }

  /* YOUR GRIDS */
  #cat-grid-{{ section.id }} .category-grid-2-1 {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 260px 220px auto;
    gap: 16px;
    max-width: 100%;
  }

  #cat-grid-{{ section.id }} .category-grid-1-3 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 240px 0;
    gap: 16px;
    max-width: 100%;
  }

  #cat-grid-{{ section.id }} .category-grid-2 {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 16px;
    max-width: 100%;
  }

  #cat-grid-{{ section.id }} .grid-inner-70-30 {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 0;
    align-items: end;
  }

  /* TILES */
  #cat-grid-{{ section.id }} .tile {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  #cat-grid-{{ section.id }} .tile img {
    width: 100%;
    height: 248px;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease;
  }

  #cat-grid-{{ section.id }} .tile:hover img {
    transform: scale(1.05);
  }

  #cat-grid-{{ section.id }} .tile span {
    position: absolute;
    bottom: 16px;
    left: 16px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    z-index: 2;
  }

  /* POSITION CLASSES */
  #cat-grid-{{ section.id }} .tile--science { grid-row: 1 / span 2; grid-column: 1 / 2; }
  #cat-grid-{{ section.id }} .tile--art { grid-column: 2 / 4; }
  #cat-grid-{{ section.id }} .tile--engineering { grid-column: 2 / 4; }

  #cat-grid-{{ section.id }} .tile--culture { grid-column: 1 / 2; }
  #cat-grid-{{ section.id }} .tile--infant { grid-column: 2 / 5; }

  #cat-grid-{{ section.id }} .padding-15 { padding-top: 15px; }

  #cat-grid-{{ section.id }} .tile--hero { grid-column: 1 / -1; }
  #cat-grid-{{ section.id }} .tile--wide { grid-column: 1 / -1; }

  #cat-grid-{{ section.id }} .tile--half-left { grid-column: 1 / 7; height: 240px; }
  #cat-grid-{{ section.id }} .tile--half-right { grid-column: 7 / -1; height: 200px; }

  #cat-grid-{{ section.id }} .height-auto{ height: auto; }
  #cat-grid-{{ section.id }} .height-set{ height: 245px; }

  #cat-grid-{{ section.id }} .tile--tall {
    transform: translateY(-18px);
    position: relative;
    z-index: 1;
    overflow: hidden;
    top: -9%;
    left: -1.6%;
    width: 90%;
    border-radius: 20px;
  }

  #cat-grid-{{ section.id }} .tile--tall img{ height: 300px; }
  #cat-grid-{{ section.id }} .cat-tile--wide{ margin-bottom: 55px; }
  #cat-grid-{{ section.id }} .tile--science img{ height: 100%; }
  #cat-grid-{{ section.id }} .tile--hero img{ height: 265px; }

  /* BOTTOM 3 COL */
  #cat-grid-{{ section.id }} .category-grid-3-col {
    display: grid;
    grid-template-columns: 25% 35% 40%;
    gap: 16px;
    max-width: 100%;
    margin: -2em auto 3em auto;
    width:95%;
    padding-bottom:30px;
  }

  #cat-grid-{{ section.id }} .tile-image-height-fix img{ height: 280px; }

  /* MOBILE */
  @media (max-width: 780px) {

    #cat-grid-{{ section.id }} .cat-grid-top {
      grid-template-columns: 1fr;
    }

    #cat-grid-{{ section.id }} .category-grid-2-1 {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    #cat-grid-{{ section.id }} .grid-inner-70-30 {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #cat-grid-{{ section.id }} .category-grid-2 {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    #cat-grid-{{ section.id }} .tile {
      height: 220px;
    }

    #cat-grid-{{ section.id }} .category-grid-3-col {
      grid-template-columns: 1fr;
      max-width: 100%;
      margin: 0 auto 30px;
      padding: 0 12px;
    }
  }
  </style>

  {% comment %}
    Build slot map from blocks.
    Each slot expects ONE block. If you add duplicates, the last one wins.
  {% endcomment %}

  {% liquid
    assign b_science = nil
    assign b_art = nil
    assign b_engineering = nil
    assign b_culture = nil
    assign b_infant = nil

    assign b_hero = nil
    assign b_wide = nil
    assign b_half_left = nil
    assign b_half_right = nil

    assign b_lower_half_left = nil
    assign b_lower_half_right = nil

    assign b_music = nil
    assign b_math = nil

    assign b_bottom_1 = nil
    assign b_bottom_2 = nil
    assign b_bottom_3 = nil
  %}

  {% for block in section.blocks %}
    {% if block.type == 'tile' %}
      {% case block.settings.slot %}
        {% when 'science' %}{% assign b_science = block %}
        {% when 'art' %}{% assign b_art = block %}
        {% when 'engineering' %}{% assign b_engineering = block %}
        {% when 'culture' %}{% assign b_culture = block %}
        {% when 'infant' %}{% assign b_infant = block %}

        {% when 'hero' %}{% assign b_hero = block %}
        {% when 'wide' %}{% assign b_wide = block %}
        {% when 'half_left' %}{% assign b_half_left = block %}
        {% when 'half_right' %}{% assign b_half_right = block %}

        {% when 'lower_half_left' %}{% assign b_lower_half_left = block %}
        {% when 'lower_half_right' %}{% assign b_lower_half_right = block %}

        {% when 'music' %}{% assign b_music = block %}
        {% when 'math' %}{% assign b_math = block %}

        {% when 'bottom_1' %}{% assign b_bottom_1 = block %}
        {% when 'bottom_2' %}{% assign b_bottom_2 = block %}
        {% when 'bottom_3' %}{% assign b_bottom_3 = block %}
      {% endcase %}
    {% endif %}
  {% endfor %}

  {% comment %} TOP: LEFT + RIGHT (fixed) {% endcomment %}
  <div class="cat-grid-top middle-grid">

    {% comment %} LEFT HALF {% endcomment %}
    <div class="cat-grid-left">

      <div class="category-grid-2">

        {% if b_science %}
          {% assign b = b_science %}
          {%- liquid
            assign link = ''
            case b.settings.link_type
              when 'collection'  if b.settings.collection != blank  assign link = b.settings.collection.url  endif
              when 'product'     if b.settings.product != blank     assign link = b.settings.product.url     endif
              when 'url'         if b.settings.link != blank        assign link = b.settings.link           endif
            endcase
          -%}
          {% if link != blank %}<a class="tile tile--science" href="{{ link }}" {{ b.shopify_attributes }}>{% else %}<div class="tile tile--science" {{ b.shopify_attributes }}>{% endif %}
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}

        {% if b_art %}
          {% assign b = b_art %}
          {%- liquid
            assign link = ''
            case b.settings.link_type
              when 'collection'  if b.settings.collection != blank  assign link = b.settings.collection.url  endif
              when 'product'     if b.settings.product != blank     assign link = b.settings.product.url     endif
              when 'url'         if b.settings.link != blank        assign link = b.settings.link           endif
            endcase
          -%}
          {% if link != blank %}<a class="tile tile--art" href="{{ link }}" {{ b.shopify_attributes }}>{% else %}<div class="tile tile--art" {{ b.shopify_attributes }}>{% endif %}
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}

        {% if b_engineering %}
          {% assign b = b_engineering %}
          {%- liquid
            assign link = ''
            case b.settings.link_type
              when 'collection'  if b.settings.collection != blank  assign link = b.settings.collection.url  endif
              when 'product'     if b.settings.product != blank     assign link = b.settings.product.url     endif
              when 'url'         if b.settings.link != blank        assign link = b.settings.link           endif
            endcase
          -%}
          {% if link != blank %}<a class="tile tile--engineering" href="{{ link }}" {{ b.shopify_attributes }}>{% else %}<div class="tile tile--engineering" {{ b.shopify_attributes }}>{% endif %}
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}

      </div>

      <div class="category-grid-1-3 padding-15">

        {% if b_culture %}
          {% assign b = b_culture %}
          {%- liquid
            assign link = ''
            case b.settings.link_type
              when 'collection'  if b.settings.collection != blank  assign link = b.settings.collection.url  endif
              when 'product'     if b.settings.product != blank     assign link = b.settings.product.url     endif
              when 'url'         if b.settings.link != blank        assign link = b.settings.link           endif
            endcase
          -%}
          {% if link != blank %}<a class="tile tile--culture" href="{{ link }}" {{ b.shopify_attributes }}>{% else %}<div class="tile tile--culture" {{ b.shopify_attributes }}>{% endif %}
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}

        {% if b_infant %}
          {% assign b = b_infant %}
          {%- liquid
            assign link = ''
            case b.settings.link_type
              when 'collection'  if b.settings.collection != blank  assign link = b.settings.collection.url  endif
              when 'product'     if b.settings.product != blank     assign link = b.settings.product.url     endif
              when 'url'         if b.settings.link != blank        assign link = b.settings.link           endif
            endcase
          -%}
          {% if link != blank %}<a class="tile tile--infant" href="{{ link }}" {{ b.shopify_attributes }}>{% else %}<div class="tile tile--infant" {{ b.shopify_attributes }}>{% endif %}
            {% if b.settings.image != blank %}
              {{ b.settings.image | image_url: width: 2000 | image_tag: alt: b.settings.title, loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            <span>{{ b.settings.title }}</span>
          {% if link != blank %}</a>{% else %}</div>{% endif %}
        {% endif %}

      </div>

    </div>

    {% comment %} RIGHT HALF {% endcomment %}
    <div class="cat-grid-right">
      <div class="category-grid-2-1 hero-grid">
        {% if b_hero %}{% render 'cat-grid-tile', b: b_hero, class: 'tile tile--hero', image_width: 2400 %}{% endif %}
        {% if b_wide %}{% render 'cat-grid-tile', b: b_wide, class: 'tile tile--wide', image_width: 2400 %}{% endif %}
        {% if b_half_left %}{% render 'cat-grid-tile', b: b_half_left, class: 'tile tile--half-left', image_width: 2400 %}{% endif %}
        {% if b_half_right %}{% render 'cat-grid-tile', b: b_half_right, class: 'tile tile--half-right', image_width: 2400 %}{% endif %}
      </div>
    </div>

  </div>

  {% comment %} MIDDLE AREA (keep your original layout but without floats) {% endcomment %}
  <div class="widthFullMiddle">
    
     <div class="width-full-wrapper">

    <div class="grid-inner-70-30" style="grid-template-columns: 35% 65%; gap: 20px;">

      {% comment %} LEFT (35%) two tiles {% endcomment %}
      <div class="grid-left-middle">
        <div class="category-grid-2-1 height-set" style="max-width:100%;">

          {% if b_lower_half_left %}
            {% render 'cat-grid-tile', b: b_lower_half_left, class: 'tile tile--half-left height-set grid-full-width', image_width: 2400 %}
          {% endif %}

          {% if b_lower_half_right %}
            {% render 'cat-grid-tile', b: b_lower_half_right, class: 'tile tile--half-right height-set grid-full-width', image_width: 2400 %}
          {% endif %}

        </div>
      </div>

      {% comment %} RIGHT (65%) music + math {% endcomment %}
      <div>
        <div class="grid-inner-70-30 right-tile-bottom-area">

          {% if b_music %}
            {% render 'cat-grid-tile', b: b_music, class: 'tile cat-tile--wide', image_width: 2400 %}
          {% endif %}

          {% if b_math %}
            {% render 'cat-grid-tile', b: b_math, class: 'tile tile--tall', image_width: 2400 %}
          {% endif %}

        </div>
      </div>

    </div>
    </div>
  </div>

  {% comment %} BOTTOM 3 COL {% endcomment %}
  <div class="width-full">
    <div class="category-grid-3-col">

      {% if b_bottom_1 %}{% render 'cat-grid-tile', b: b_bottom_1, class: 'tile tile-image-height-fix', image_width: 2400 %}{% endif %}
      {% if b_bottom_2 %}{% render 'cat-grid-tile', b: b_bottom_2, class: 'tile tile-image-height-fix', image_width: 2400 %}{% endif %}
      {% if b_bottom_3 %}{% render 'cat-grid-tile', b: b_bottom_3, class: 'tile tile-image-height-fix', image_width: 2400 %}{% endif %}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Category Grid",
  "max_blocks": 16,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "slot",
          "label": "Slot / Position",
          "options": [
            { "value": "science", "label": " Science (left big)" },
            { "value": "art", "label": "Art (left top right)" },
            { "value": "engineering", "label": "Engineering (left bottom right)" },
            { "value": "culture", "label": "Culture (left small)" },
            { "value": "infant", "label": "Infant (left wide)" },

            { "value": "hero", "label": " Hero (right top)" },
            { "value": "wide", "label": "Wide (right middle)" },
            { "value": "half_left", "label": "Half Left (right bottom left)" },
            { "value": "half_right", "label": "Half Right (right bottom right)" },

            { "value": "lower_half_left", "label": "Lower Half Left (bottom left)" },
            { "value": "lower_half_right", "label": "Lower Half Right (bottom right)" },

            { "value": "music", "label": "Music Wide (bottom 65% left)" },
            { "value": "math", "label": "Math Tall (bottom 65% right)" },

            { "value": "bottom_1", "label": "Bottom 3-col #1" },
            { "value": "bottom_2", "label": "Bottom 3-col #2" },
            { "value": "bottom_3", "label": "Bottom 3-col #3" }
          ],
          "default": "science"
        },

        { "type": "image_picker", "id": "image", "label": "Image" },

        {
          "type": "select",
          "id": "link_type",
          "label": "Link type",
          "options": [
            { "value": "collection", "label": "Collection" },
            { "value": "product", "label": "Product" },
            { "value": "url", "label": "Custom URL" }
          ],
          "default": "collection"
        },

        { "type": "collection", "id": "collection", "label": "Collection (if Link type = Collection)" },
        { "type": "product", "id": "product", "label": "Product (if Link type = Product)" },
        { "type": "url", "id": "link", "label": "Custom URL (if Link type = Custom URL)" },

        {
          "type": "textarea",
          "id": "title",
          "label": "Title (HTML allowed like <br>)",
          "default": "Title"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Category Grid" }
  ]
}
{% endschema %}
