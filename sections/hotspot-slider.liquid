<section class="hotspot-slider" id="hotspot-slider-{{ section.id }}" aria-label="Image slider with hotspots">
  <div class="slider" data-slider>
    <div class="slides" data-slides>
      {%- assign first_slide_id = blank -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- if first_slide_id == blank -%}{%- assign first_slide_id = block.settings.slide_id -%}{%- endif -%}

          {%- assign slide_collection = block.settings.collection -%}
          {%- assign slide_image = block.settings.image -%}

          <article class="slide {% if forloop.first %}is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
            {%- assign slide_collection = block.settings.collection -%}
            {%- assign slide_image = block.settings.image -%}
            {%- assign slide_bg = block.settings.bg_image -%}

            <div
            class="slide-media{% if slide_bg != blank %} has-bg{% endif %}"
            {% if slide_bg != blank %}
                style="background-image:url({{ slide_bg | image_url: width: 2400 }});"
            {% endif %}
            >
            {% if slide_image != blank %}
                {{ slide_image
                | image_url: width: 2000
                | image_tag: loading: 'lazy', alt: block.settings.image_alt, class: 'slide-media__img'
                }}
            {% elsif slide_bg == blank %}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}



              {%- comment -%} Render hotspots that match this slide_id {%- endcomment -%}
              {%- for hb in section.blocks -%}
                {%- if hb.type == 'hotspot' and hb.settings.slide_id == block.settings.slide_id -%}
                  {%- assign p = hb.settings.product -%}
                  {%- if p != blank -%}
                    <button class="hotspot"
                      style="--x: {{ hb.settings.x }}%; --y: {{ hb.settings.y }}%;"
                      data-product='{
                        "title": {{ p.title | json }},
                        "price": {{ p.price | money | json }},
                        "compare_at": {{ p.compare_at_price | money | json }},
                        "image": {{ p.featured_image | image_url: width: 600 | json }},
                        "url": {{ p.url | json }}
                      }'
                      aria-label="View product: {{ p.title | escape }}">
                      <span class="hotspot__plus" aria-hidden="true">+</span>
                    </button>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="slide-footer">
              {% if block.settings.caption != blank %}
                <p class="slide-caption">{{ block.settings.caption }}</p>
              {% endif %}

              {%- if slide_collection != blank -%}
                <a class="btn" href="{{ slide_collection.url }}">
                  {{ block.settings.button_label | default: 'VIEW ALL' }}
                </a>
              {%- else -%}
                <a class="btn" href="#">
                  {{ block.settings.button_label | default: 'VIEW ALL' }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Arrows -->
    <button class="nav nav--prev" data-prev aria-label="Previous slide">
      {% if section.settings.prev_icon != blank %}
        {{ section.settings.prev_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: 'Previous' }}
      {% else %}
        ‹
      {% endif %}
    </button>

    <button class="nav nav--next" data-next aria-label="Next slide">
      {% if section.settings.next_icon != blank %}
        {{ section.settings.next_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: 'Next' }}
      {% else %}
        ›
      {% endif %}
    </button>

    <!-- Dots -->
    <div class="dots" data-dots aria-label="Slide navigation"></div>
  </div>
</section>

<!-- Modal -->
<div class="modal" data-modal aria-hidden="true">
  <div class="modal__backdrop" data-close></div>

  <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Product details">
    <button class="modal__close" data-close aria-label="Close">×</button>

    <div class="product-card">
      <div class="product-card__img">
        <img data-modal-image alt="" />
      </div>

      <div class="product-card__info">
        <h3 class="product-card__title" data-modal-title></h3>
        <div class="product-card__price" data-modal-price></div>

        <div class="product-card__actions" aria-label="Actions">
          <a class="icon-btn" data-modal-link title="View" aria-label="View details">🔍</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>

:root{
  --maxw: 1100px;
  --gap: 16px;
}

*{ box-sizing:border-box; }
body{
  margin:0;
}

.hotspot-slider{
  padding: 32px 16px;
}

.slider{
  position: relative;
  max-width: var(--maxw);
  margin: 0 auto;
}

.slides{
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  background:#f3f3f3;
}

.slide{
  display:none;
}
.slide.is-active{
  display:block;
}

.slide-media{ background-size: contain; background-color:#eaeaea; }


.slide-media img{
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}

/* Hotspots */
.hotspot{
  
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 0;
  cursor: pointer;
  background: rgba(33, 41, 66, .75);
  display:grid;
  place-items:center;
  color:#fff;
  box-shadow: 0 8px 20px rgba(0,0,0,.18);

  position: absolute;
  left: var(--x);
  top: var(--y);
  transform: translate(-50%, -50%);


}

.hotspot::after{
  content:"";
  position:absolute;
  inset:-10px;
  border-radius:999px;
  background: rgba(33, 41, 66, .18);
  opacity: .9;
}

.hotspot__plus{
  position:relative;
  z-index:1;
  font-size: 18px;
  line-height: 1;
}

/* Nav arrows */
.nav{
  position:absolute;
  top: 37%;
  border: 0;
  cursor:pointer;
  display:grid;
  place-items:center;
  background:transparent;
}

/* Footer */
.slide-footer{
  text-align:center;
  padding: 18px 12px 24px;
  background:#fff;
}
.slide-caption{
  margin: 0 0 27px;
  font-size: 18px;
  color:#000;
  font-family: "Shantell Sans", cursive;
  font-weight: 500;

}
.btn{
  display:inline-block;
  padding: 10px 18px;
  border-radius: 0;
  background:#111;
  color:#fff;
  text-decoration:none;
  font-size: 13px;
  letter-spacing: .06em;
   font-family: "Lexend", sans-serif;
   text-decoration:underline;

}

/* Dots */
.dots{
  display:flex;
  justify-content:center;
  gap: 8px;
  padding: 12px 0 0;
}
.dot{
  width: 8px;
  height: 8px;
  border-radius: 999px;
  border:0;
  background:#d2d2d2;
  cursor:pointer;
}
.dot.is-active{
  background:#111;
}

/* Modal */
.modal{
  position: fixed;
  inset: 0;
  display:none;
  z-index: 50;
}
.modal.is-open{
  display:block;
}
.modal__backdrop{
  position:absolute;
  inset:0;
  background: rgba(0,0,0,.55);
}
.modal__panel{
  position:absolute;
  left: 50%;
  top: 55%;
  transform: translate(-50%, -50%);
  width: min(720px, calc(100% - 32px));
  background: transparent;
}
.modal__close{
  position:absolute;
  right: 6px;
  top: -44px;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border:0;
  cursor:pointer;
  background: rgba(255,255,255,.9);
  font-size: 22px;
}

/* Product card (matches your popup vibe) */
.product-card{
  display:flex;
  gap: 18px;
  align-items:center;
  padding: 22px;
  border-radius: 18px;
  background:#fff;
  box-shadow: 0 18px 60px rgba(0,0,0,.28);
}

.product-card__img{
  width: 150px;
  height: 150px;
  border-radius: 12px;
  background:#f5f5f5;
  overflow:hidden;
  flex: 0 0 auto;
  display:grid;
  place-items:center;
}
.product-card__img img{
  width:100%;
  height:100%;
  object-fit: contain;
  display:block;
}

.product-card__title{
  margin:0 0 8px;
  font-size: 22px;
  font-weight: 600;
}
.product-card__price{
  color: #d61f1f;
  font-weight: 700;
  font-size: 20px;
  margin-bottom: 14px;
}

.product-card__actions{
  display:flex;
  gap: 10px;
}

.icon-btn{
  width: 38px;
  height: 38px;
  border-radius: 999px;
  border: 0;
  cursor:pointer;
  background:#111;
  color:#fff;
  display:grid;
  place-items:center;
  font-size: 16px;
}


.nav--prev img, .nav--next  img{
    height:40px;
    width:40px;
}

.nav--next{
    right:5px;
}

.nav--prev img{
    position: relative;
    margin-left: -5em;

}

.nav--next  img{
     position: relative;
    margin-right: -5em;
}

@media (max-width: 680px){
  .slide-caption{ font-size: 16px; }
  .product-card{ flex-direction: column; align-items: flex-start; }
  .product-card__img{ width: 100%; height: 190px; }
}



</style>

<script>
  (function () {
  const slider = document.querySelector("[data-slider]");
  if (!slider) return;

  const slidesWrap = slider.querySelector("[data-slides]");
  const slides = Array.from(slidesWrap.querySelectorAll("[data-slide]"));
  const prevBtn = slider.querySelector("[data-prev]");
  const nextBtn = slider.querySelector("[data-next]");
  const dotsWrap = slider.querySelector("[data-dots]");

  const modal = document.querySelector("[data-modal]");
  const modalTitle = document.querySelector("[data-modal-title]");
  const modalPrice = document.querySelector("[data-modal-price]");
  const modalImage = document.querySelector("[data-modal-image]");
  const modalClosers = Array.from(document.querySelectorAll("[data-close]"));

  let index = slides.findIndex(s => s.classList.contains("is-active"));
  if (index < 0) index = 0;

  // Build dots
  slides.forEach((_, i) => {
    const b = document.createElement("button");
    b.className = "dot" + (i === index ? " is-active" : "");
    b.type = "button";
    b.setAttribute("aria-label", `Go to slide ${i + 1}`);
    b.addEventListener("click", () => goTo(i));
    dotsWrap.appendChild(b);
  });

  const dots = Array.from(dotsWrap.querySelectorAll(".dot"));

  function goTo(i) {
    slides[index].classList.remove("is-active");
    dots[index].classList.remove("is-active");

    index = (i + slides.length) % slides.length;

    slides[index].classList.add("is-active");
    dots[index].classList.add("is-active");
  }

  prevBtn?.addEventListener("click", () => goTo(index - 1));
  nextBtn?.addEventListener("click", () => goTo(index + 1));

  // Hotspot -> modal
  slider.addEventListener("click", (e) => {
    const hotspot = e.target.closest(".hotspot");
    if (!hotspot) return;

    const raw = hotspot.getAttribute("data-product");
    if (!raw) return;

    let data;
    try { data = JSON.parse(raw); } catch { return; }

    modalTitle.textContent = data.title || "";
    modalPrice.textContent = data.price || "";
    modalImage.src = data.image || "";
    modalImage.alt = data.title || "Product image";

    openModal();
  });

  function openModal() {
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  modalClosers.forEach(el => el.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal.classList.contains("is-open")) closeModal();
    if (e.key === "ArrowLeft") goTo(index - 1);
    if (e.key === "ArrowRight") goTo(index + 1);
  });
})();

</script>

{% schema %}
{
  "name": "Hotspot Slider",
  "settings": [
    { "type": "range", "id": "max_width", "min": 900, "max": 1800, "step": 10, "default": 1400, "label": "Max width (px)" },
    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 1, "default": 18, "label": "Image radius (px)" },

    { "type": "image_picker", "id": "prev_icon", "label": "Prev arrow icon" },
    { "type": "image_picker", "id": "next_icon", "label": "Next arrow icon" },

    { "type": "color", "id": "plus_bg", "default": "#ffffff", "label": "Plus background" },
    { "type": "color", "id": "plus_color", "default": "#000000", "label": "Plus color" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide (collection)",
      "settings": [
        { "type": "text", "id": "slide_id", "label": "Slide ID (unique, e.g. slide-1)", "default": "slide-1" },
        { "type": "collection", "id": "collection", "label": "Collection (VIEW ALL links here)" },
        { "type": "image_picker", "id": "image", "label": "Slide image" },
        { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Hotspot slide image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "VIEW ALL" }
      ]
    },
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "text", "id": "slide_id", "label": "Assign to Slide ID (must match a slide)", "default": "slide-1" },

        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "default": 10, "label": "X position (%)" },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "default": 50, "label": "Y position (%)" },

        { "type": "product", "id": "product", "label": "Product (should belong to that slide’s collection)" }
      ]
    }
  ],
  "presets": [
    { "name": "Hotspot Slider", "category": "Media" }
  ]
}
{% endschema %}
