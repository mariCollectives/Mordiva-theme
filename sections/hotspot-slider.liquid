{% comment %}
  Section: Hotspot Slider
  - Block type "slide": slide image + caption + button
  - Block type "hotspot": product + x/y + slide number
{% endcomment %}

<section class="hotspot-slider" id="hotspot-slider-{{ section.id }}" aria-label="Image slider with hotspots">
  <div class="hs-slider" data-hs-slider>
    <div class="hs-slides" data-hs-slides>
      {%- assign slide_blocks = section.blocks | where: "type", "slide" -%}
      {%- assign hotspot_blocks = section.blocks | where: "type", "hotspot" -%}

      {%- for s in slide_blocks -%}
        {%- assign slide_index = forloop.index -%}
        <article class="hs-slide {% if forloop.first %}is-active{% endif %}" data-hs-slide>
          <div class="hs-slide-media">
            {%- if s.settings.image != blank -%}
              {{ s.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: s.settings.alt | default: 'Slide image' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}

            {%- comment -%} Hotspots for this slide {%- endcomment -%}
            {%- for h in hotspot_blocks -%}
              {%- if h.settings.slide_number == slide_index and h.settings.product != blank -%}
                {%- assign p = h.settings.product -%}
                {%- assign v = p.selected_or_first_available_variant -%}
                {%- assign img = p.featured_image -%}

                <button
                  class="hs-hotspot"
                  type="button"
                  style="--x: {{ h.settings.x }}%; --y: {{ h.settings.y }}%;"
                  data-hs-product='{
                    "title": {{ p.title | json }},
                    "price": {{ v.price | money | json }},
                    "image": {{ img | image_url: width: 900 | json }},
                    "url": {{ p.url | json }},
                    "variant_id": {{ v.id | json }}
                  }'
                  aria-label="View product: {{ p.title | escape }}">
                  <span class="hs-hotspot__plus" aria-hidden="true">+</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="hs-slide-footer">
            {%- if s.settings.caption != blank -%}
              <p class="hs-caption">{{ s.settings.caption }}</p>
            {%- endif -%}

            {%- if s.settings.button_label != blank and s.settings.button_link != blank -%}
              <a class="hs-btn" href="{{ s.settings.button_link }}">{{ s.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <button class="hs-nav hs-nav--prev" type="button" data-hs-prev aria-label="Previous slide">
      {%- if section.settings.arrow_left != blank -%}
        {{ section.settings.arrow_left | image_url: width: 120 | image_tag: alt: 'Previous' }}
      {%- else -%}
        ‹
      {%- endif -%}
    </button>

    <button class="hs-nav hs-nav--next" type="button" data-hs-next aria-label="Next slide">
      {%- if section.settings.arrow_right != blank -%}
        {{ section.settings.arrow_right | image_url: width: 120 | image_tag: alt: 'Next' }}
      {%- else -%}
        ›
      {%- endif -%}
    </button>

    <div class="hs-dots" data-hs-dots aria-label="Slide navigation"></div>
  </div>

  <!-- Modal (scoped per section instance) -->
  <div class="hs-modal" data-hs-modal aria-hidden="true">
    <div class="hs-modal__backdrop" data-hs-close></div>

    <div class="hs-modal__panel" role="dialog" aria-modal="true" aria-label="Product details">
      <button class="hs-modal__close" type="button" data-hs-close aria-label="Close">×</button>

      <div class="hs-product-card">
        <div class="hs-product-card__img">
          <img data-hs-modal-image alt="" loading="lazy" />
        </div>

        <div class="hs-product-card__info">
          <h3 class="hs-product-card__title" data-hs-modal-title></h3>
          <div class="hs-product-card__price" data-hs-modal-price></div>

          <div class="hs-product-card__actions" aria-label="Actions">
            <button class="hs-icon-btn" type="button" title="Wishlist" aria-label="Wishlist">♡</button>
            <button class="hs-icon-btn" type="button" data-hs-add title="Add" aria-label="Add to cart">+</button>
            <a class="hs-icon-btn" data-hs-view title="Search" aria-label="View details">🔍</a>
          </div>

          <div class="hs-feedback" data-hs-feedback aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>

  <style>
    #hotspot-slider-{{ section.id }} { position: relative; max-width: 100%; }
    #hotspot-slider-{{ section.id }} .hs-slider { position: relative; overflow: hidden; }
    #hotspot-slider-{{ section.id }} .hs-slide { display: none; }
    #hotspot-slider-{{ section.id }} .hs-slide.is-active { display: block; }
    #hotspot-slider-{{ section.id }} .hs-slide-media { position: relative; border-radius: 18px; overflow: hidden; }
    #hotspot-slider-{{ section.id }} .hs-slide-media img { width: 100%; height: auto; display:block; }

    #hotspot-slider-{{ section.id }} .hs-hotspot{
      position: absolute;
      left: var(--x);
      top: var(--y);
      transform: translate(-50%, -50%);
      width: 44px; height: 44px;
      border: 0; border-radius: 999px;
      background: rgba(0,0,0,.35);
      backdrop-filter: blur(6px);
      cursor: pointer;
      display: grid; place-items: center;
    }
    #hotspot-slider-{{ section.id }} .hs-hotspot__plus{
      width: 28px; height: 28px;
      border-radius: 999px;
      background: rgba(0,0,0,.55);
      color: #fff;
      display:grid; place-items:center;
      font-size: 18px; line-height: 1;
    }

    #hotspot-slider-{{ section.id }} .hs-nav{
      position: absolute; top: 50%;
      transform: translateY(-50%);
      width: 48px; height: 48px;
      border: 0; background: transparent;
      cursor: pointer; z-index: 5;
      display:grid; place-items:center;
    }
    #hotspot-slider-{{ section.id }} .hs-nav--prev{ left: 16px; }
    #hotspot-slider-{{ section.id }} .hs-nav--next{ right: 16px; }

    #hotspot-slider-{{ section.id }} .hs-dots{
      display:flex; gap: 10px; justify-content:center;
      padding: 14px 0 0;
    }
    #hotspot-slider-{{ section.id }} .hs-dot{
      width: 10px; height: 10px; border-radius: 999px;
      border: 0; background: rgba(0,0,0,.2); cursor: pointer;
    }
    #hotspot-slider-{{ section.id }} .hs-dot.is-active{ background: rgba(0,0,0,.65); }

    #hotspot-slider-{{ section.id }} .hs-slide-footer{
      text-align:center; padding: 14px 0 0;
    }
    #hotspot-slider-{{ section.id }} .hs-caption{ margin: 0 0 10px; }
    #hotspot-slider-{{ section.id }} .hs-btn{
      display:inline-block; padding: 10px 18px;
      background:#111; color:#fff; text-decoration:none;
    }

    #hotspot-slider-{{ section.id }} .hs-modal{
      position: fixed; inset: 0;
      display:none; z-index: 9999;
    }
    #hotspot-slider-{{ section.id }} .hs-modal.is-open{ display:block; }
    #hotspot-slider-{{ section.id }} .hs-modal__backdrop{
      position:absolute; inset:0; background: rgba(0,0,0,.55);
    }
    #hotspot-slider-{{ section.id }} .hs-modal__panel{
      position: relative;
      max-width: 900px;
      margin: 10vh auto 0;
      background: #fff;
      border-radius: 18px;
      padding: 22px;
      z-index: 1;
    }
    #hotspot-slider-{{ section.id }} .hs-modal__close{
      position:absolute; right: 14px; top: 12px;
      width: 40px; height: 40px;
      border:0; border-radius: 999px;
      background: #f3f3f3; cursor:pointer;
    }
    #hotspot-slider-{{ section.id }} .hs-product-card{
      display:grid;
      grid-template-columns: 220px 1fr;
      gap: 18px;
      align-items: center;
    }
    #hotspot-slider-{{ section.id }} .hs-product-card__img{
      width: 220px; height: 220px;
      border-radius: 14px; overflow:hidden;
      background:#f6f6f6;
      display:grid; place-items:center;
    }
    #hotspot-slider-{{ section.id }} .hs-product-card__img img{
      width:100%; height:100%; object-fit: cover; display:block;
    }
    #hotspot-slider-{{ section.id }} .hs-product-card__price{ color: #c00; font-weight: 700; margin-top: 6px; }
    #hotspot-slider-{{ section.id }} .hs-product-card__actions{ display:flex; gap: 12px; margin-top: 14px; }
    #hotspot-slider-{{ section.id }} .hs-icon-btn{
      width: 38px; height: 38px;
      border-radius: 999px; border:0;
      background:#111; color:#fff;
      display:grid; place-items:center;
      cursor:pointer; text-decoration:none;
    }
    #hotspot-slider-{{ section.id }} .hs-feedback{ margin-top: 10px; font-size: 14px; }
    @media (max-width: 700px){
      #hotspot-slider-{{ section.id }} .hs-product-card{ grid-template-columns: 1fr; }
      #hotspot-slider-{{ section.id }} .hs-product-card__img{ width: 100%; height: 220px; }
      #hotspot-slider-{{ section.id }} .hs-modal__panel{ margin: 8vh 14px 0; }
    }
  </style>

  <script>
    (function () {
      const root = document.getElementById("hotspot-slider-{{ section.id }}");
      if (!root) return;

      const slider = root.querySelector("[data-hs-slider]");
      const slidesWrap = root.querySelector("[data-hs-slides]");
      const slides = Array.from(slidesWrap.querySelectorAll("[data-hs-slide]"));
      const prevBtn = root.querySelector("[data-hs-prev]");
      const nextBtn = root.querySelector("[data-hs-next]");
      const dotsWrap = root.querySelector("[data-hs-dots]");

      const modal = root.querySelector("[data-hs-modal]");
      const modalTitle = root.querySelector("[data-hs-modal-title]");
      const modalPrice = root.querySelector("[data-hs-modal-price]");
      const modalImage = root.querySelector("[data-hs-modal-image]");
      const modalClosers = Array.from(root.querySelectorAll("[data-hs-close]"));
      const addBtn = root.querySelector("[data-hs-add]");
      const viewLink = root.querySelector("[data-hs-view]");
      const feedback = root.querySelector("[data-hs-feedback]");

      let index = slides.findIndex(s => s.classList.contains("is-active"));
      if (index < 0) index = 0;

      // Build dots
      dotsWrap.innerHTML = "";
      slides.forEach((_, i) => {
        const b = document.createElement("button");
        b.className = "hs-dot" + (i === index ? " is-active" : "");
        b.type = "button";
        b.setAttribute("aria-label", `Go to slide ${i + 1}`);
        b.addEventListener("click", () => goTo(i));
        dotsWrap.appendChild(b);
      });
      const dots = Array.from(dotsWrap.querySelectorAll(".hs-dot"));

      function goTo(i) {
        slides[index].classList.remove("is-active");
        dots[index].classList.remove("is-active");
        index = (i + slides.length) % slides.length;
        slides[index].classList.add("is-active");
        dots[index].classList.add("is-active");
      }

      prevBtn && prevBtn.addEventListener("click", () => goTo(index - 1));
      nextBtn && nextBtn.addEventListener("click", () => goTo(index + 1));

      let currentVariantId = null;

      // Hotspot -> modal
      slider.addEventListener("click", (e) => {
        const hotspot = e.target.closest(".hs-hotspot");
        if (!hotspot) return;

        const raw = hotspot.getAttribute("data-hs-product");
        if (!raw) return;

        let data;
        try { data = JSON.parse(raw); } catch { return; }

        modalTitle.textContent = data.title || "";
        modalPrice.textContent = data.price || "";
        modalImage.src = data.image || "";
        modalImage.alt = data.title || "Product image";
        currentVariantId = data.variant_id || null;
        if (viewLink) viewLink.href = data.url || "#";
        if (feedback) feedback.textContent = "";

        openModal();
      });

      function openModal() {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      modalClosers.forEach(el => el.addEventListener("click", closeModal));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal.classList.contains("is-open")) closeModal();
        if (e.key === "ArrowLeft") goTo(index - 1);
        if (e.key === "ArrowRight") goTo(index + 1);
      });

      // Add to cart
      addBtn && addBtn.addEventListener("click", async () => {
        if (!currentVariantId) return;
        addBtn.disabled = true;
        try {
          const res = await fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: currentVariantId, quantity: 1 })
          });
          if (!res.ok) throw new Error("Add failed");
          if (feedback) feedback.textContent = "Added to cart.";
        } catch (err) {
          if (feedback) feedback.textContent = "Could not add to cart.";
        } finally {
          addBtn.disabled = false;
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Hotspot slider",
  "settings": [
    { "type": "image_picker", "id": "arrow_left", "label": "Left arrow image" },
    { "type": "image_picker", "id": "arrow_right", "label": "Right arrow image" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slide image" },
        { "type": "text", "id": "alt", "label": "Image alt text" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "VIEW ALL" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "range", "id": "slide_number", "label": "Slide number (1 = first slide)", "min": 1, "max": 12, "step": 1, "default": 1 },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "label": "X position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Y position (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [
    { "name": "Hotspot slider", "blocks": [{ "type": "slide" }, { "type": "hotspot" }] }
  ]
}
{% endschema %}
