{% comment %}
  Section: What's New Product Slider
  - Select a collection
  - Shows a horizontal slider with arrows
  - Max width: 1400px
{% endcomment %}

<section id="wn-slider-{{ section.id }}" class="wn-slider" aria-label="What's New product slider">
  <div class="wn-inner">
    {% if section.settings.heading != blank %}
      <h2 class="wn-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wn-shell">
      <button class="wn-nav wn-nav--prev" type="button" aria-label="Previous" data-wn-prev>
        ‹
      </button>

      <div class="wn-track" data-wn-track>
        {% assign c = section.settings.collection %}
        {% if c != blank and c.products_count > 0 %}
          {% for product in c.products limit: section.settings.limit %}
            {% assign v = product.selected_or_first_available_variant %}
            <a class="wn-card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <div class="wn-media">
                {% if product.featured_image %}
                  {{ product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      alt: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'wn-placeholder' }}
                {% endif %}
              </div>

              <div class="wn-title">{{ product.title }}</div>
              <div class="wn-price">
                {% if v.compare_at_price > v.price %}
                  <span class="wn-price--sale">{{ v.price | money }}</span>
                  <span class="wn-price--compare">{{ v.compare_at_price | money }}</span>
                {% else %}
                  <span>{{ v.price | money }}</span>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        {% else %}
          <div class="wn-empty">
            Select a collection with products.
          </div>
        {% endif %}
      </div>

      <button class="wn-nav wn-nav--next" type="button" aria-label="Next" data-wn-next>
        ›
      </button>
    </div>
  </div>

  <style>
    #wn-slider-{{ section.id }}{
      padding: {{ section.settings.pad_y }}px 16px;
    }

    #wn-slider-{{ section.id }} .wn-inner{
      max-width: 1400px;
      margin: 0 auto;
    }

    #wn-slider-{{ section.id }} .wn-heading{
      margin: 0 0 18px;
      text-align: center;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    #wn-slider-{{ section.id }} .wn-shell{
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Track = horizontal scroll slider */
    #wn-slider-{{ section.id }} .wn-track{
      position: relative;
      flex: 1;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - ({{ section.settings.gap }}px * ({{ section.settings.per_view }} - 1))) / {{ section.settings.per_view }});
      gap: {{ section.settings.gap }}px;

      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;

      padding: 6px 2px;
    }

    /* hide scrollbar */
    #wn-slider-{{ section.id }} .wn-track::-webkit-scrollbar{ height: 0; }
    #wn-slider-{{ section.id }} .wn-track{ scrollbar-width: none; }

    #wn-slider-{{ section.id }} .wn-card{
      scroll-snap-align: start;
      display: grid;
      grid-template-rows: auto auto auto;
      justify-items: center;
      text-decoration: none;
      color: inherit;
      padding: 4px 6px;
      min-width: 0;
    }

    #wn-slider-{{ section.id }} .wn-media{
      width: 100%;
      aspect-ratio: 1 / 1;
      display: grid;
      place-items: center;
    }

    #wn-slider-{{ section.id }} .wn-media img,
    #wn-slider-{{ section.id }} .wn-placeholder{
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #wn-slider-{{ section.id }} .wn-title{
      margin-top: 10px;
      font-size: 12px;
      line-height: 1.3;
      text-align: center;
      max-width: 100%;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    #wn-slider-{{ section.id }} .wn-price{
      margin-top: 6px;
      font-size: 12px;
      text-align: center;
      opacity: 0.9;
    }

    #wn-slider-{{ section.id }} .wn-price--compare{
      margin-left: 6px;
      text-decoration: line-through;
      opacity: 0.6;
      font-size: 11px;
    }

    /* Arrows */
    #wn-slider-{{ section.id }} .wn-nav{
      width: 40px;
      height: 40px;
      border-radius: 999px;
      border: 0;
      background: transparent;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
      display: grid;
      place-items: center;
      user-select: none;
    }

    #wn-slider-{{ section.id }} .wn-nav[disabled]{
      opacity: 0.25;
      cursor: default;
    }

    /* Mobile: show 2 products per view */
    @media (max-width: 749px){
      #wn-slider-{{ section.id }} .wn-track{
        grid-auto-columns: calc((100% - {{ section.settings.gap }}px) / 2);
      }
      #wn-slider-{{ section.id }} .wn-heading{
        font-size: 22px;
      }
    }
  </style>

  <script>
    (function(){
      const root = document.getElementById('wn-slider-{{ section.id }}');
      if(!root) return;

      const track = root.querySelector('[data-wn-track]');
      const prev = root.querySelector('[data-wn-prev]');
      const next = root.querySelector('[data-wn-next]');

      if(!track || !prev || !next) return;

      function getStep(){
        const first = track.querySelector('.wn-card');
        if(!first) return track.clientWidth;
        const styles = window.getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
        return first.getBoundingClientRect().width + gap;
      }

      function updateDisabled(){
        const maxScroll = track.scrollWidth - track.clientWidth - 1;
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= maxScroll;
      }

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      next.addEventListener('click', () => {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateDisabled, { passive: true });
      window.addEventListener('resize', updateDisabled);
      updateDisabled();
    })();
  </script>
</section>

{% schema %}
{
  "name": "Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What’s New."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 30,
      "step": 1,
      "label": "Max products",
      "default": 12
    },
    {
      "type": "range",
      "id": "per_view",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per view (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "label": "Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "pad_y",
      "min": 0,
      "max": 80,
      "step": 4,
      "label": "Section vertical padding",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product Slider"
    }
  ]
}
{% endschema %}
