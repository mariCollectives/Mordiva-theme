{% comment %}
  Section: Category Mosaic Collections
  - Each tile: image picker + collection picker
  - Title + URL come from the selected collection
  - Custom height per tile (desktop/mobile)
{% endcomment %}

<section class="cat-mosaic" id="cat-mosaic-{{ section.id }}">
  <style>
    #cat-mosaic-{{ section.id }} {
      --gap: {{ section.settings.gap }}px;
      --radius: {{ section.settings.radius }}px;
      --maxw: {{ section.settings.max_width }}px;
    }

    #cat-mosaic-{{ section.id }} .cat-mosaic__wrap{
      max-width: 100%;
      margin: 0 auto;
      padding: 0 {{ section.settings.side_padding }}px;
    }

    #cat-mosaic-{{ section.id }} .tile {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      text-decoration: none;
      display: block;
    }

    #cat-mosaic-{{ section.id }} .tile__media{
      width: 100%;
      height: var(--tile-h, 240px);
    }

    #cat-mosaic-{{ section.id }} .tile__media img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 260ms ease;
      transform: scale(1);
    }

    #cat-mosaic-{{ section.id }} .tile:hover .tile__media img{
      transform: scale(1.05);
    }

    #cat-mosaic-{{ section.id }} .tile__label{
      position: absolute;
      left: 16px;
      bottom: 16px;
      z-index: 2;
      color: #fff;
      font-size: 18px;
      font-weight: 500;
      line-height: 1.2;
      text-shadow: 0 2px 10px rgba(0,0,0,.25);
    }

    #cat-mosaic-{{ section.id }} .tile::after{
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(to top, rgba(0,0,0,.45), transparent 60%);
      pointer-events: none;
    }

    /* Layout */
    #cat-mosaic-{{ section.id }} .row-1{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap);
      align-items: start;
    }

    #cat-mosaic-{{ section.id }} .col-left{
      display: grid;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .grid-2{
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 240px 240px;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .grid-2 .tile--science{ grid-row: 1 / span 2; grid-column: 1 / 2; }
    #cat-mosaic-{{ section.id }} .grid-2 .tile--art{ grid-column: 2 / 4; }
    #cat-mosaic-{{ section.id }} .grid-2 .tile--engineering{ grid-column: 2 / 4; }

    #cat-mosaic-{{ section.id }} .grid-1-3{
      display: grid;
      grid-template-columns: 1fr 3fr; /* culture 25% / infant 75% */
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .col-right{
      display: grid;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .grid-2-1{
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: 260px 220px auto;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .grid-2-1 .tile--hero{ grid-column: 1 / -1; }
    #cat-mosaic-{{ section.id }} .grid-2-1 .tile--wide{ grid-column: 1 / -1; }
    #cat-mosaic-{{ section.id }} .grid-2-1 .tile--half-left{ grid-column: 1 / 7; }
    #cat-mosaic-{{ section.id }} .grid-2-1 .tile--half-right{ grid-column: 7 / -1; }

    #cat-mosaic-{{ section.id }} .row-2{
      display: grid;
      grid-template-columns: 35% 65%;
      gap: var(--gap);
      margin-top: var(--gap);
      align-items: start;
    }

    #cat-mosaic-{{ section.id }} .row-2-left{
      display: grid;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .row-2-left .mini-2{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap);
    }

    #cat-mosaic-{{ section.id }} .row-2-right .grid-inner-70-30{
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 18px;
      align-items: end;
    }

    #cat-mosaic-{{ section.id }} .tile--tall{
      transform: translateY(-18px);
      position: relative;
      z-index: 2;
      width: 90%;
      border-radius: var(--radius);
    }

    #cat-mosaic-{{ section.id }} .row-3{
      display: grid;
      grid-template-columns: 25% 35% 40%;
      gap: var(--gap);
      margin-top: calc(var(--gap) * 1.25);
      margin-bottom: 30px;
    }

    /* Mobile */
    @media (max-width: {{ section.settings.mobile_breakpoint }}px){
      #cat-mosaic-{{ section.id }} .row-1{
        grid-template-columns: 1fr;
      }

      #cat-mosaic-{{ section.id }} .grid-2{
        grid-template-columns: 1fr;
        grid-template-rows: none;
      }
      #cat-mosaic-{{ section.id }} .grid-2 .tile--science,
      #cat-mosaic-{{ section.id }} .grid-2 .tile--art,
      #cat-mosaic-{{ section.id }} .grid-2 .tile--engineering{
        grid-column: auto;
        grid-row: auto;
      }

      #cat-mosaic-{{ section.id }} .grid-1-3{
        grid-template-columns: 1fr;
      }

      #cat-mosaic-{{ section.id }} .grid-2-1{
        grid-template-columns: 1fr;
        grid-template-rows: none;
      }
      #cat-mosaic-{{ section.id }} .grid-2-1 .tile--hero,
      #cat-mosaic-{{ section.id }} .grid-2-1 .tile--wide,
      #cat-mosaic-{{ section.id }} .grid-2-1 .tile--half-left,
      #cat-mosaic-{{ section.id }} .grid-2-1 .tile--half-right{
        grid-column: auto;
      }

      #cat-mosaic-{{ section.id }} .row-2{
        grid-template-columns: 1fr;
      }

      #cat-mosaic-{{ section.id }} .row-2-right .grid-inner-70-30{
        grid-template-columns: 1fr;
        gap: 14px;
      }

      #cat-mosaic-{{ section.id }} .tile--tall{
        transform: none;
        width: 100%;
      }

      #cat-mosaic-{{ section.id }} .row-3{
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="cat-mosaic__wrap">

    {%- comment -%} ROW 1 {%- endcomment -%}
    <div class="row-1">
      <div class="col-left">

        {%- comment -%} Left: 3 tiles grid {%- endcomment -%}
        <div class="grid-2">
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | first, section: section, class_name: 'tile--science' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 1, 1 | first, section: section, class_name: 'tile--art' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 2, 1 | first, section: section, class_name: 'tile--engineering' %}
        </div>

        {%- comment -%} Left: 2 tiles (25/75) {%- endcomment -%}
        <div class="grid-1-3">
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 3, 1 | first, section: section, class_name: 'tile--culture' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 4, 1 | first, section: section, class_name: 'tile--infant' %}
        </div>

      </div>

      {%- comment -%} Right: hero/wide/half/half {%- endcomment -%}
      <div class="col-right">
        <div class="grid-2-1">
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 5, 1 | first, section: section, class_name: 'tile--hero' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 6, 1 | first, section: section, class_name: 'tile--wide' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 7, 1 | first, section: section, class_name: 'tile--half-left' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 8, 1 | first, section: section, class_name: 'tile--half-right' %}
        </div>
      </div>
    </div>

    {%- comment -%} ROW 2 {%- endcomment -%}
    <div class="row-2">
      <div class="row-2-left">
        <div class="mini-2">
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 7, 1 | first, section: section, class_name: '' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 8, 1 | first, section: section, class_name: '' %}
        </div>
      </div>

      <div class="row-2-right">
        <div class="grid-inner-70-30">
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 9, 1 | first, section: section, class_name: 'cat-tile--wide' %}
          {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 10, 1 | first, section: section, class_name: 'tile--tall' %}
        </div>
      </div>
    </div>

    {%- comment -%} ROW 3 {%- endcomment -%}
    <div class="row-3">
      {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 11, 1 | first, section: section, class_name: '' %}
      {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 12, 1 | first, section: section, class_name: '' %}
      {% render 'cat-mosaic-tile', block: section.blocks | where: "type", "tile" | slice: 13, 1 | first, section: section, class_name: '' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Category Mosaic",
  "settings": [
    { "type": "range", "id": "max_width", "min": 900, "max": 1800, "step": 50, "unit": "px", "label": "Max width", "default": 1400 },
    { "type": "range", "id": "side_padding", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Side padding", "default": 0 },
    { "type": "range", "id": "gap", "min": 8, "max": 30, "step": 1, "unit": "px", "label": "Gap", "default": 16 },
    { "type": "range", "id": "radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Border radius", "default": 18 },
    { "type": "range", "id": "mobile_breakpoint", "min": 480, "max": 990, "step": 10, "unit": "px", "label": "Mobile breakpoint", "default": 780 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection (title + URL)" },
        { "type": "image_picker", "id": "image", "label": "Tile image" },
        { "type": "range", "id": "height_desktop", "min": 140, "max": 520, "step": 10, "unit": "px", "label": "Height (desktop)", "default": 240 },
        { "type": "range", "id": "height_mobile", "min": 140, "max": 420, "step": 10, "unit": "px", "label": "Height (mobile)", "default": 220 },
        { "type": "text", "id": "override_title", "label": "Optional title override", "default": " Optional title override" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Category Mosaic",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
