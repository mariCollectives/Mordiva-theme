{% liquid
  assign c = block.settings.collection
  assign title = block.settings.override_title | strip

  if title == blank and c != blank
    assign title = c.title
  endif

  assign href = '#'
  if c != blank
    assign href = c.url
  endif

  assign img = block.settings.image
  assign h_desktop = block.settings.height_desktop | default: 240
  assign h_mobile  = block.settings.height_mobile  | default: 220
%}

{% if block != blank %}
  <a class="tile {{ class_name }}" href="{{ href }}" style="--tile-h: {{ h_desktop }}px;">
    <div class="tile__media">
      {% if img != blank %}
        {{ img
          | image_url: width: 2000
          | image_tag: loading: 'lazy', alt: title
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
    </div>

    {% if title != blank %}
      <span class="tile__label">{{ title }}</span>
    {% endif %}
  </a>

  <style>
    @media (max-width: {{ section.settings.mobile_breakpoint }}px){
      #cat-mosaic-{{ section.id }} .tile[style*="--tile-h: {{ h_desktop }}px"]{ --tile-h: {{ h_mobile }}px; }
    }
  </style>
{% endif %}
