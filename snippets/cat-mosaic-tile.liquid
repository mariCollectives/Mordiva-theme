{% liquid
  assign b = block

  comment
    b can be nil when you do:
    section.blocks | where: ... | first
  endcomment

  assign href = '#'
  if b and b.settings.link != blank
    assign href = b.settings.link
  endif

  assign title = ''
  if b and b.settings.title != blank
    assign title = b.settings.title | strip
  endif

  assign img = blank
  if b and b.settings.image != blank
    assign img = b.settings.image
  endif
%}

{% if b %}
  <a class="{{ class_name }}" href="{{ href }}" {{ b.shopify_attributes }}>
    {% if img != blank %}
      {%- comment -%} Primary (new) {%- endcomment -%}
      {{ img | image_url: width: 2000 | image_tag: loading: 'lazy', alt: title }}

      {%- comment -%}
        If your theme is older and the above still outputs nothing, use this instead:
        {{ img | img_url: '2000x' | img_tag: title, 'lazy' }}
      {%- endcomment -%}

    {% else %}
      {{ 'image' | placeholder_svg_tag }}
    {% endif %}

    {% if title != blank %}
      {% if b.settings.title_allow_br %}
        <span>{{ title }}</span>
      {% else %}
        <span>{{ title | strip_html }}</span>
      {% endif %}
    {% endif %}
  </a>
{% endif %}
